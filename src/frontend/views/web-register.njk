{% extends "layout.njk" %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set pageTitle = "Web register" %}
{% set activeNav = "web-register" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">Web register</h1>
      <p class="govuk-body-l govuk-!-margin-bottom-2">
        {{ shownCount }} of {{ totalCount }} entries{% if filtered %} (filtered){% endif %}
      </p>
      <p class="govuk-body govuk-hint govuk-!-margin-bottom-6">
        {{ linkedCount }} of {{ totalCount }} entries are matched to a service in the directory.
      </p>

      <form method="get" action="/web-register" class="govuk-!-margin-bottom-6">
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-one-half">
            {{ govukInput({
              label: { text: "Search", classes: "govuk-label--s" },
              id: "q", name: "q", type: "search", value: q,
              spellcheck: false,
              attributes: { placeholder: "Entry, department or status" }
            }) }}
          </div>
          <div class="govuk-grid-column-one-half">
            {{ govukSelect({
              label: { text: "Match to a service", classes: "govuk-label--s" },
              id: "link", name: "link", items: linkItems
            }) }}
          </div>
        </div>
        <div class="govuk-button-group">
          {{ govukButton({ text: "Filter" }) }}
          {% if filtered %}<a class="govuk-link" href="/web-register">Clear filters</a>{% endif %}
        </div>
      </form>

      {% if rows.length %}
        {{ govukTable({
          head: [
            { text: "Entry" },
            { text: "Type" },
            { text: "Status" },
            { text: "Matched service" }
          ],
          rows: rows
        }) }}
      {% else %}
        <p class="govuk-body">No entries match your search.</p>
      {% endif %}
    </div>
  </div>
{% endblock %}
